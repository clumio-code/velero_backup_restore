{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "s3Allow",
			"Effect": "Allow",
			"Action": [
				"s3:*"
			],
			"Resource": [
				"arn:aws:s3:::clumio-automation",
				"arn:aws:s3:::clumio-automation/*"
			]
		},
		{
			"Sid": "lambdaAllow",
			"Effect": "Allow",
			"Action": [
				"states:*",
				"lambda:*"
			],
			"Resource": [
				"*"
			]
		},
		{
			"Sid": "secretAllow",
			"Effect": "Allow",
			"Action": [
				"secretsmanager:GetSecretValue"
			],
			"Resource": [
				"*"
			]
		},
		{
			"Sid": "logsAllow",
			"Effect": "Allow",
			"Action": [
				"logs:CreateLogGroup",
				"logs:CreateLogStream",
				"logs:PutLogEvents"
			],
			"Resource": "*"
		},
		{
			"Sid": "EC2Allow",
			"Effect": "Allow",
			"Action": [
				"ec2:DescribeVolumes",
				"ec2:CreateSnapshot",
				"ec2:CreateTags",
				"ec2:DeleteVolume"
			],
			"Resource": "*"
		}
	]
}
